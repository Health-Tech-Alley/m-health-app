{
  "expo": {
    "name": "m-health-app",
    "slug": "m-health-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/access-dp-app-icon.png",
    "scheme": "mhealthapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/access-dp-app-icon.png",
      "bundleIdentifier": "com.rahalcloud.mhealthapp",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/access-dp-adaptive-foreground.png",
        "monochromeImage": "./assets/images/access-dp-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rahalcloud.mhealthapp",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/access-dp-notification-small-icon.png"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Caregiver Concierge reads heart rate, oxygen saturation, respiratory rate, blood pressure, temperature, steps, sleep, and related vitals from Apple Health to detect early warning signs for your care recipient. This data stays on your device and is only shared with your care team when you explicitly consent.",
          "background": true
        }
      ],
      "./plugins/with-local-only-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3064312-7363-46b7-b60d-3b68a3197342"
      }
    },
    "owner": "rahal-cloud"
  }
}
